{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(./scripts/verify.sh)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m structsplat:*)",
      "Bash(python -m benchmarks.ablation:*)",
      "Bash(python scripts/docs_sync.py)",
      "Bash(python scripts/check_ara.py)",
      "Bash(python scripts/check_task_policy.py)",
      "Bash(python scripts/check_script_layout.py)",
      "Bash(ruff:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pip install:*)"
    ]
  }
}
